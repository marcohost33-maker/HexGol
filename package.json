{
  "name": "hexgol",
  "version": "33.4.0",
  "private": true,
  "type": "module",
  "description": "GolHex - Hexagonal Game of Life (v31) with real-valued physics + unitary HQST quantum mode",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",

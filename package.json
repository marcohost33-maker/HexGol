{
  "name": "hexgol",
  "version": "33.5.0",
  "private": true,
  "type": "module",
  "description": "GolHex - Hexagonal Game of Life with real-valued physics + unitary HQST quantum mode",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-pwa-build.mjs && node scripts/verify-csp-contract.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node tests/unit/mutation-probe.mjs",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
